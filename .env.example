# ---- Login to this site ----
APP_PASSWORD=choose-a-strong-password
SESSION_SECRET=any-long-random-text-at-least-32-characters

# ---- Intuit app keys (developer.intuit.com -> your app -> Keys & credentials) ----
QB_CLIENT_ID=
QB_CLIENT_SECRET=
# sandbox = test company (development keys), production = the real company
QB_ENVIRONMENT=sandbox
# Must exactly match a Redirect URI added in the Intuit app
QB_REDIRECT_URI=http://localhost:8000/api/qb/callback

# ---- WooCommerce (read-only REST key: WooCommerce > Settings > Advanced > REST API) ----
WOO_URL=https://clubhousedrops.com
WOO_KEY=
WOO_SECRET=

# ---- QuickBooks document numbers (how receipts are named in QBO) ----
DOC_PREFIX_SALE=Woo Order#
DOC_PREFIX_REFUND=Woo Refund#

# ---- Safety ----
# Writes to a PRODUCTION QuickBooks company stay blocked unless this is exactly "yes".
ALLOW_PRODUCTION_WRITES=no

# ---- Storage (Upstash Redis; Vercel Storage -> Upstash sets KV_REST_API_* automatically) ----
KV_REST_API_URL=
KV_REST_API_TOKEN=
